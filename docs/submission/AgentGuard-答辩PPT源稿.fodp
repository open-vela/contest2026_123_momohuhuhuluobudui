<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:mimetype="application/vnd.oasis.opendocument.presentation" office:version="1.3">
  <office:styles>
    <style:default-style style:family="paragraph"><style:text-properties fo:font-family="Noto Sans CJK SC"/></style:default-style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="PM1"><style:page-layout-properties fo:page-width="33.867cm" fo:page-height="19.05cm" style:print-orientation="landscape"/></style:page-layout>
    <style:style style:name="dp1" style:family="drawing-page"><style:drawing-page-properties draw:fill="solid" draw:fill-color="#081724"/></style:style>
    <style:style style:name="gText" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="none" draw:auto-grow-height="true"/></style:style>
    <style:style style:name="gCard" style:family="graphic"><style:graphic-properties draw:stroke="solid" svg:stroke-color="#285267" draw:fill="solid" draw:fill-color="#102f40" draw:textarea-horizontal-align="left"/></style:style>
    <style:style style:name="PTitle" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0.3cm"/><style:text-properties fo:font-family="Noto Sans CJK SC" fo:font-size="32pt" fo:font-weight="bold" fo:color="#f6fbff"/></style:style>
    <style:style style:name="PSub" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0.18cm"/><style:text-properties fo:font-family="Noto Sans CJK SC" fo:font-size="18pt" fo:color="#b9d2df"/></style:style>
    <style:style style:name="PHead" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0.25cm"/><style:text-properties fo:font-family="Noto Sans CJK SC" fo:font-size="20pt" fo:font-weight="bold" fo:color="#4de0c1"/></style:style>
    <style:style style:name="PBody" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0.22cm"/><style:text-properties fo:font-family="Noto Sans CJK SC" fo:font-size="16pt" fo:color="#e5f0f5"/></style:style>
    <style:style style:name="PSmall" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0.12cm"/><style:text-properties fo:font-family="Noto Sans CJK SC" fo:font-size="11pt" fo:color="#9fb8c5"/></style:style>
    <style:style style:name="PMetric" style:family="paragraph"><style:paragraph-properties fo:text-align="center"/><style:text-properties fo:font-family="Noto Sans CJK SC" fo:font-size="25pt" fo:font-weight="bold" fo:color="#ffffff"/></style:style>
  </office:automatic-styles>
  <office:master-styles><style:master-page style:name="Default" style:page-layout-name="PM1" draw:style-name="dp1"/></office:master-styles>
  <office:body>
    <office:presentation>
      <draw:page draw:name="01-title" draw:style-name="dp1" draw:master-page-name="Default">
        <draw:frame draw:style-name="gText" svg:x="2.1cm" svg:y="4.6cm" svg:width="29.5cm" svg:height="4.5cm"><draw:text-box><text:p text:style-name="PTitle">AgentGuard</text:p><text:p text:style-name="PSub">基于 openvela + ESP-DL 的桌面健康与隐私守护终端</text:p><text:p text:style-name="PBody">端侧人数感知 · 久坐提醒 · 自动隐私遮罩 · 事件统计</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gText" svg:x="2.1cm" svg:y="14.6cm" svg:width="29.5cm" svg:height="2cm"><draw:text-box><text:p text:style-name="PSmall">2026 首届 openvela AI 硬件开发者大赛｜AI 硬件产品创新</text:p><text:p text:style-name="PSmall">魔魔胡胡胡萝卜队｜队长：闫贺翔｜其他成员：无</text:p></draw:text-box></draw:frame>
      </draw:page>

      <draw:page draw:name="02-problem" draw:style-name="dp1" draw:master-page-name="Default">
        <draw:frame draw:style-name="gText" svg:x="1.6cm" svg:y="1.1cm" svg:width="30.6cm" svg:height="1.5cm"><draw:text-box><text:p text:style-name="PTitle">01 真实问题：健康与屏幕隐私同时发生</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="1.8cm" svg:y="4cm" svg:width="9.2cm" svg:height="9.5cm"><draw:text-box><text:p text:style-name="PHead">久坐风险</text:p><text:p text:style-name="PBody">伏案工作时容易忽略时间，普通定时器无法判断用户是否真的在座。</text:p><text:p text:style-name="PBody">需要结合“人在画面中”的实际状态计时和提醒。</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="12.3cm" svg:y="4cm" svg:width="9.2cm" svg:height="9.5cm"><draw:text-box><text:p text:style-name="PHead">窥屏风险</text:p><text:p text:style-name="PBody">开放办公室或家庭环境中，身后来人可能看到敏感屏幕。</text:p><text:p text:style-name="PBody">需要在第二人出现时快速、自动、可恢复地遮挡电脑。</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="22.8cm" svg:y="4cm" svg:width="9.2cm" svg:height="9.5cm"><draw:text-box><text:p text:style-name="PHead">隐私约束</text:p><text:p text:style-name="PBody">云端视觉会引入图像上传和网络依赖。</text:p><text:p text:style-name="PBody">AgentGuard 在开发板本地检测，只把结构化事件发送给电脑。</text:p></draw:text-box></draw:frame>
      </draw:page>

      <draw:page draw:name="03-solution" draw:style-name="dp1" draw:master-page-name="Default">
        <draw:frame draw:style-name="gText" svg:x="1.6cm" svg:y="1.1cm" svg:width="30.6cm" svg:height="1.5cm"><draw:text-box><text:p text:style-name="PTitle">02 方案：一个端侧感知、双场景闭环</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="2cm" svg:y="4.2cm" svg:width="6.1cm" svg:height="4.4cm"><draw:text-box><text:p text:style-name="PHead">V4L2 摄像头</text:p><text:p text:style-name="PBody">RGB565 实时帧</text:p><text:p text:style-name="PSmall">图像不离开开发板</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gText" svg:x="8.5cm" svg:y="5.4cm" svg:width="2cm" svg:height="1cm"><draw:text-box><text:p text:style-name="PMetric">→</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="10.5cm" svg:y="4.2cm" svg:width="6.1cm" svg:height="4.4cm"><draw:text-box><text:p text:style-name="PHead">ESP-DL</text:p><text:p text:style-name="PBody">人脸框 + 人数</text:p><text:p text:style-name="PSmall">尽量保留官方算法层</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gText" svg:x="17cm" svg:y="5.4cm" svg:width="2cm" svg:height="1cm"><draw:text-box><text:p text:style-name="PMetric">→</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="19cm" svg:y="4.2cm" svg:width="6.1cm" svg:height="4.4cm"><draw:text-box><text:p text:style-name="PHead">策略状态机</text:p><text:p text:style-name="PBody">久坐 / 隐私 / 故障降级</text:p><text:p text:style-name="PSmall">确定性、可复现</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gText" svg:x="25.5cm" svg:y="5.4cm" svg:width="2cm" svg:height="1cm"><draw:text-box><text:p text:style-name="PMetric">→</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="27.5cm" svg:y="4.2cm" svg:width="4.3cm" svg:height="4.4cm"><draw:text-box><text:p text:style-name="PHead">反馈</text:p><text:p text:style-name="PBody">LCD / LED</text:p><text:p text:style-name="PBody">USB / HTTP</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="4.2cm" svg:y="11.2cm" svg:width="11.5cm" svg:height="4cm"><draw:text-box><text:p text:style-name="PHead">健康闭环</text:p><text:p text:style-name="PBody">在座计时 → STAND UP → LED 闪烁 → BOOT 确认 → 事件统计</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="18.2cm" svg:y="11.2cm" svg:width="11.5cm" svg:height="4cm"><draw:text-box><text:p text:style-name="PHead">隐私闭环</text:p><text:p text:style-name="PBody">隐私待命 → FACE:2 → LED 双闪 + 电脑遮罩 → FACE:1 自动恢复</text:p></draw:text-box></draw:frame>
      </draw:page>

      <draw:page draw:name="04-implementation" draw:style-name="dp1" draw:master-page-name="Default">
        <draw:frame draw:style-name="gText" svg:x="1.6cm" svg:y="1.1cm" svg:width="30.6cm" svg:height="1.5cm"><draw:text-box><text:p text:style-name="PTitle">03 核心实现与 openvela 能力</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="1.8cm" svg:y="3.8cm" svg:width="9.4cm" svg:height="11cm"><draw:text-box><text:p text:style-name="PHead">图形与多媒体通路</text:p><text:p text:style-name="PBody">• V4L2 获取摄像头帧</text:p><text:p text:style-name="PBody">• 240×240 LCD 实时预览</text:p><text:p text:style-name="PBody">• 多人检测框与状态底栏</text:p><text:p text:style-name="PBody">• DMA/缓存路径稳定化</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="12.3cm" svg:y="3.8cm" svg:width="9.4cm" svg:height="11cm"><draw:text-box><text:p text:style-name="PHead">ESP-DL 兼容层</text:p><text:p text:style-name="PBody">• RGB565 输入适配</text:p><text:p text:style-name="PBody">• NuttX 内存与任务兼容</text:p><text:p text:style-name="PBody">• 官方算法层最小改动</text:p><text:p text:style-name="PBody">• 不进行主人身份识别</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="22.8cm" svg:y="3.8cm" svg:width="9.4cm" svg:height="11cm"><draw:text-box><text:p text:style-name="PHead">系统与协同</text:p><text:p text:style-name="PBody">• LittleFS 有界事件日志</text:p><text:p text:style-name="PBody">• USB 串口优先，HTTP 可选</text:p><text:p text:style-name="PBody">• 电脑通知、全屏遮罩、CSV</text:p><text:p text:style-name="PBody">• 断线不阻塞板端检测</text:p></draw:text-box></draw:frame>
      </draw:page>

      <draw:page draw:name="05-demo" draw:style-name="dp1" draw:master-page-name="Default">
        <draw:frame draw:style-name="gText" svg:x="1.6cm" svg:y="1.1cm" svg:width="30.6cm" svg:height="1.5cm"><draw:text-box><text:p text:style-name="PTitle">04 可演示的完整功能链</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="1.8cm" svg:y="3.7cm" svg:width="14.4cm" svg:height="5.1cm"><draw:text-box><text:p text:style-name="PHead">人脸检测与人数统计</text:p><text:p text:style-name="PMetric">FACE:0 → FACE:1 → FACE:2</text:p><text:p text:style-name="PBody">单人显示一个框，双人显示两个框</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="17.5cm" svg:y="3.7cm" svg:width="14.4cm" svg:height="5.1cm"><draw:text-box><text:p text:style-name="PHead">久坐提醒</text:p><text:p text:style-name="PMetric">DEMO 20 秒</text:p><text:p text:style-name="PBody">STAND UP + LED + 电脑通知 + BOOT 确认</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="1.8cm" svg:y="10.3cm" svg:width="14.4cm" svg:height="5.1cm"><draw:text-box><text:p text:style-name="PHead">隐私保护</text:p><text:p text:style-name="PMetric">第二人进入即触发</text:p><text:p text:style-name="PBody">Power LED 双闪 + 电脑不透明全屏遮罩</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="17.5cm" svg:y="10.3cm" svg:width="14.4cm" svg:height="5.1cm"><draw:text-box><text:p text:style-name="PHead">事件统计</text:p><text:p text:style-name="PMetric">久坐 / 确认 / 隐私</text:p><text:p text:style-name="PBody">实时面板、JSONL 留存与 CSV 导出</text:p></draw:text-box></draw:frame>
      </draw:page>

      <draw:page draw:name="06-evidence" draw:style-name="dp1" draw:master-page-name="Default">
        <draw:frame draw:style-name="gText" svg:x="1.6cm" svg:y="1.1cm" svg:width="30.6cm" svg:height="1.5cm"><draw:text-box><text:p text:style-name="PTitle">05 工程证据与可靠性边界</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="1.8cm" svg:y="4cm" svg:width="9.3cm" svg:height="9.8cm"><draw:text-box><text:p text:style-name="PMetric">22</text:p><text:p text:style-name="PHead">电脑端自动化测试</text:p><text:p text:style-name="PBody">代理、USB 启动、事件统计、Dashboard 和 Demo 启动器测试通过。</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="12.3cm" svg:y="4cm" svg:width="9.3cm" svg:height="9.8cm"><draw:text-box><text:p text:style-name="PMetric">2,414,780 B</text:p><text:p text:style-name="PHead">最终固件</text:p><text:p text:style-name="PBody">小于 0x300000 分区限制；刷写时 Flash 哈希验证通过。</text:p><text:p text:style-name="PSmall">SHA-256: fbf3dbe8…0b27ddf</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="22.8cm" svg:y="4cm" svg:width="9.3cm" svg:height="9.8cm"><draw:text-box><text:p text:style-name="PMetric">15 / 1,820</text:p><text:p text:style-name="PHead">AI 会话 / 事件</text:p><text:p text:style-name="PBody">1,992,096 Token；官方日志校验器 ALL OK；沉淀 1 个可复用 Coding Skill。</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gText" svg:x="2cm" svg:y="15.5cm" svg:width="29.5cm" svg:height="1.3cm"><draw:text-box><text:p text:style-name="PSmall">真实性边界：未使用标准数据集测量精确率/召回率，未宣称主人识别、KWS、手势、功耗或长稳数据。</text:p></draw:text-box></draw:frame>
      </draw:page>

      <draw:page draw:name="07-value" draw:style-name="dp1" draw:master-page-name="Default">
        <draw:frame draw:style-name="gText" svg:x="1.6cm" svg:y="1.1cm" svg:width="30.6cm" svg:height="1.5cm"><draw:text-box><text:p text:style-name="PTitle">06 价值与下一步</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="2cm" svg:y="4cm" svg:width="14cm" svg:height="10.5cm"><draw:text-box><text:p text:style-name="PHead">应用价值</text:p><text:p text:style-name="PBody">• 面向开放办公室、家庭书房和本地隐私工作台</text:p><text:p text:style-name="PBody">• 不依赖云端视觉，降低部署与隐私成本</text:p><text:p text:style-name="PBody">• 状态机可迁移到更多带摄像头的 openvela 终端</text:p><text:p text:style-name="PBody">• 电脑代理扩展通知、统计和安全策略</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gCard" svg:x="17.8cm" svg:y="4cm" svg:width="14cm" svg:height="10.5cm"><draw:text-box><text:p text:style-name="PHead">后续规划</text:p><text:p text:style-name="PBody">• 补充标准数据集、功耗与长时间稳定性测试</text:p><text:p text:style-name="PBody">• 优化边缘角度和遮挡下的多人稳定性</text:p><text:p text:style-name="PBody">• 设计桌面外壳与更清晰的本地交互</text:p><text:p text:style-name="PBody">• 资源允许时增加符合指定唤醒词的本地 KWS</text:p></draw:text-box></draw:frame>
      </draw:page>

      <draw:page draw:name="08-end" draw:style-name="dp1" draw:master-page-name="Default">
        <draw:frame draw:style-name="gText" svg:x="2.2cm" svg:y="5.3cm" svg:width="29.5cm" svg:height="5cm"><draw:text-box><text:p text:style-name="PTitle">让桌面终端看得见风险，</text:p><text:p text:style-name="PTitle">但不让摄像头画面离开设备。</text:p><text:p text:style-name="PSub">AgentGuard · openvela + ESP-DL</text:p></draw:text-box></draw:frame>
        <draw:frame draw:style-name="gText" svg:x="2.2cm" svg:y="14.8cm" svg:width="29.5cm" svg:height="1.5cm"><draw:text-box><text:p text:style-name="PSmall">代码仓库：https://github.com/open-vela/contest2026_123_momohuhuhuluobudui</text:p><text:p text:style-name="PSmall">魔魔胡胡胡萝卜队｜队长：闫贺翔｜其他成员：无</text:p></draw:text-box></draw:frame>
      </draw:page>
    </office:presentation>
  </office:body>
</office:document>
